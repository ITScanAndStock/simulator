{
  "name": "simulator",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mts",
    "db:empty": "node --env-file-if-exists=.env.local scripts/db-empty.mts",
    "price-lists:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/import-price-lists.mts",
    "settings:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-settings.mts",
    "coompy:record": "node --env-file-if-exists=.env.local scripts/record-coompy-answers.mts"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@tesseract.js-data/fra": "1.0.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "unpdf": "1.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --check --ignore-unknown"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --check --ignore-unknown"
  }
}
